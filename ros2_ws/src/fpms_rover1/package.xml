<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fpms_rover1</name>
  <version>0.1.0</version>
  <description>FPMS Rover 1 (Orange Pi 5 Max) ROS 2 nodes: LD19 LiDAR, Yahboom STM32 board, Thermal Master P1.</description>
